# Copy to keystore.properties (git-ignored) and fill in to build a signed release.
# Generate a keystore once with:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias upload
# Use the SAME key for every upload: Play ties the app to its upload certificate.
# An absolute path is safest: a relative one resolves against app/, not the project root.
storeFile=/absolute/path/to/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
